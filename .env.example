# Kiln brand book — asset overrides
#
# Every image on the site resolves through src/config/assets.ts. For each slot
# you can either set the env var below, or simply drop a file at the drop-in
# path (the registry detects it at build time and wins over the placeholder).
# Leave everything empty to keep the shipped placeholder art.

# Primary lockup — 3.2 : 1
# drop-in: public/brand/logos/primary.<svg|png|webp|jpg>
PUBLIC_LOGO_PRIMARY=

# Wordmark — 3.6 : 1
# drop-in: public/brand/logos/wordmark.<svg|png|webp|jpg>
PUBLIC_LOGO_WORDMARK=

# Monogram / app icon — 1 : 1
# drop-in: public/brand/logos/mark.<svg|png|webp|jpg>
PUBLIC_LOGO_MARK=

# Mono lockup — 3.2 : 1
# drop-in: public/brand/logos/mono.<svg|png|webp|jpg>
PUBLIC_LOGO_MONO=

# Hero tile — primary media — 4 : 5
# drop-in: public/brand/hero/media-primary.<svg|png|webp|jpg>
PUBLIC_HERO_MEDIA_PRIMARY=

# Hero tile — secondary media — 16 : 9
# drop-in: public/brand/hero/media-secondary.<svg|png|webp|jpg>
PUBLIC_HERO_MEDIA_SECONDARY=

# Presentation slide — 2.3 : 1
# drop-in: public/brand/applications/presentation.<svg|png|webp|jpg>
PUBLIC_PRESENTATION_IMAGE=

# Stage backdrop — 2 : 1
# drop-in: public/brand/applications/stage.<svg|png|webp|jpg>
PUBLIC_STAGE_IMAGE=

# Open Graph card — 1.91 : 1
# drop-in: public/brand/social/og.<svg|png|webp|jpg>
PUBLIC_OG_IMAGE=
