---
interface Props {
  n: string;
  eyebrow: string;
  title: string;
  lede: string;
  meta?: { label: string; value: string }[];
}
const { n, eyebrow, title, lede, meta = [] } = Astro.props;
---

<header class="chapter-head">
  <div class="shell shell--wide">
    <div class="chapter-head__top">
      <p class="eyebrow">Chapter {n} — {eyebrow}</p>
      <span class="chapter-head__n mono" aria-hidden="true">{n}</span>
    </div>
    <div class="chapter-head__body">
      <h1 class="chapter-head__title" data-reveal>{title}</h1>
      <p class="lede chapter-head__lede" data-reveal style="--reveal-i:1">{lede}</p>
    </div>
    {
      meta.length > 0 && (
        <dl class="chapter-head__meta">
          {meta.map((item) => (
            <div>
              <dt class="label-mono">{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))}
        </dl>
      )
    }
    <slot />
  </div>
</header>

<style>
  .chapter-head {
    padding-top: calc(var(--nav-height) + clamp(var(--space-12), 9vw, var(--space-24)));
    padding-bottom: clamp(var(--space-10), 6vw, var(--space-16));
    position: relative;
    border-bottom: 1px solid var(--line-subtle);
    overflow: clip;
  }

  .chapter-head__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--line-subtle);
  }

  .chapter-head__n {
    font-size: var(--text-xs);
    color: var(--text-tertiary);
  }

  .chapter-head__body {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(var(--space-6), 4vw, var(--space-16));
    align-items: end;
    padding-top: clamp(var(--space-8), 5vw, var(--space-12));
  }

  .chapter-head__title {
    font-size: clamp(2.5rem, 5.4vw, 4.75rem);
    line-height: 0.98;
    letter-spacing: var(--tracking-display);
    font-weight: var(--weight-semibold);
  }

  .chapter-head__lede {
    padding-bottom: 0.35em;
  }

  .chapter-head__meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--space-5);
    margin-top: clamp(var(--space-10), 6vw, var(--space-16));
    padding-top: var(--space-5);
    border-top: 1px solid var(--line-subtle);
  }

  .chapter-head__meta dd {
    margin: var(--space-2) 0 0;
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-tight);
  }

  @media (max-width: 900px) {
    .chapter-head__body {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }
</style>
