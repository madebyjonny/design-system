    font-variation-settings: "opsz" 32;
    font-size: clamp(1.4rem, 2.3vw, 2.15rem);
    line-height: 1.04;
    letter-spacing: var(--tracking-display);
    color: var(--text-primary);
  }

  .tile--cta .label-mono {
    color: var(--text-tertiary);
  }

  .tile__cta-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-top: var(--space-4);
  }

  .tile--cta :global(.btn--secondary) {
    --btn-border: var(--line-default);
    color: var(--text-primary);
    background: var(--surface-raised);
  }

  /* rail ------------------------------------------------------------------ */
  .hero__rail {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-inline: var(--gutter);
    color: var(--text-tertiary);
    opacity: calc(1 - var(--p) * 2.5);
  }

  .hero__rail-line {
    position: relative;
    height: 1px;
    flex: 1;
    background: var(--line-subtle);
    overflow: hidden;
  }

  .hero__rail-line i {
    position: absolute;
    inset: 0 auto 0 0;
    width: 22%;
    background: var(--text-primary);
    animation: rail-run 3.4s var(--ease-in-out) infinite;
  }

  @keyframes rail-run {
    0% {
      transform: translateX(-100%);
    }
    60%,
    100% {
      transform: translateX(460%);
    }
  }

  /* --------------------------------------------------------------- RESPONSIVE */
  @media (max-width: 1100px) {
    .bento {
      height: min(64svh, 580px);
      gap: 6px;
    }

    .tile {
      padding: var(--space-3) var(--space-4);
    }

    .wordmark {
      font-size: clamp(2.75rem, 6vw, 4.5rem);
    }
  }

  @media (max-width: 860px) {
    .hero {
      height: auto;
    }

    .hero__sticky {
      position: relative;
      height: auto;
      padding-block: calc(var(--nav-height) + var(--space-6)) var(--space-12);
    }

