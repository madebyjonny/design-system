---
/**
 * The brand animation.
 *
 * A bento grid assembles on load, then recedes as you scroll so the chapters
 * below take over. Every image inside is an asset-registry slot — drop a file
 * in public/brand/hero/ and it appears here on reload.
 */
import { assets, isPlaceholder } from '@/config/assets';
import { brand } from '@/config/brand';

const media = assets['hero.media.primary'];
const mediaAlt = assets['hero.media.secondary'];
const wordmark = 'kiln'.split('');
---

<section class="hero" id="top" data-hero>
  <div class="hero__sticky">
    <div class="hero__wash" aria-hidden="true"></div>

    <div class="shell shell--wide hero__stage">
      <div class="bento" data-hero-bento>
        <!-- 1 · Wordmark build -->
        <article class="tile tile--brand" style="--i:0">
          <header class="tile__head">
            <span class="badge badge-accent"><span class="dot"></span>Brand book</span>
            <span class="tile__index mono">01 — 06</span>
          </header>
          <div class="tile__brand">
            <h1 class="wordmark" aria-label={brand.name}>
              <span class="wordmark__letters" aria-hidden="true">
                {wordmark.map((letter, i) => <span class="wordmark__letter" style={`--n:${i}`}>{letter}</span>)}
              </span>
              <span class="wordmark__dot" aria-hidden="true"></span>
            </h1>
            <p class="tile__tagline">{brand.tagline}</p>
          </div>
          <footer class="tile__foot">
            <p class="body-sm">The design and motion system for products that think.</p>
            <span class="mono tile__version">v{brand.version}</span>
          </footer>
        </article>

        <!-- 2 · Ink swatch -->
        <article class="tile tile--signal" style="--i:1">
          <header class="tile__head">
            <span class="label-mono">Ink 1000</span>
            <span class="mono tile__index">#090909</span>
          </header>
          <div class="signal-mark" aria-hidden="true">
            <svg viewBox="0 0 120 120" fill="none">
              <g transform="translate(60 62)" stroke="#090909" stroke-width="5" stroke-linejoin="round" stroke-linecap="round">
                <path d="M0 -32 L-27 -18 L0 -4 L27 -18 Z" fill="#090909" />
                <path d="M-27 -18 L-27 18 L0 32 L27 18 L27 -18" />
                <path d="M0 -4 L0 32" opacity="0.45" />
              </g>
            </svg>
          </div>
          <footer class="tile__foot">
            <span class="mono tile__signal-note">Solid ink is the accent.</span>
          </footer>
        </article>

        <!-- 3 · Media slot -->
        <article class="tile tile--media" style="--i:2">
          <img class="tile__img" src={media.url} alt="" loading="eager" decoding="async" fetchpriority="high" />
          <span class="tile__scrim" aria-hidden="true"></span>
          <header class="tile__head tile__head--over">
            {isPlaceholder('hero.media.primary') ? (
              <a class="badge badge-paper" href="/logos#slots">Image slot</a>
            ) : (
              <span class="badge badge-paper">Campaign</span>
            )}
          </header>
          <footer class="tile__foot tile__foot--over">
            <p class="tile__media-title">Ship what<br />you imagine.</p>
            <span class="mono tile__ratio">{media.ratio}</span>
          </footer>
        </article>

        <!-- 4 · Marquee -->
        <article class="tile tile--marquee" style="--i:3">
          <img class="tile__img tile__img--dim" src={mediaAlt.url} alt="" aria-hidden="true" loading="lazy" decoding="async" />
          <div class="marquee" aria-hidden="true">
            <div class="marquee__track">
              {[0, 1].map(() => (
                <span class="marquee__run">
                  <em>fire for ideas</em><i>✳</i><em>design tokens</em><i>✳</i><em>css components</em><i>✳</i><em>animated svg</em><i>✳</i>
                </span>
              ))}
            </div>
          </div>
          <p class="sr-only">Fire for ideas. Design tokens, CSS components, animated SVG.</p>
        </article>

        <!-- 5 · Chart -->
        <article class="tile tile--chart" style="--i:4">
          <header class="tile__head">
            <span class="label-mono">Latency</span>
            <span class="badge badge-positive"><span class="dot"></span>steady</span>
          </header>
          <div class="chart">
            <svg class="chart__svg" viewBox="0 0 240 90" preserveAspectRatio="none" aria-hidden="true">
              <defs>
                <linearGradient id="signalFill" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#090909" stop-opacity="0.16" />
                  <stop offset="100%" stop-color="#090909" stop-opacity="0" />
                </linearGradient>
              </defs>
              <path class="chart__area" d="M0 74 C18 70 26 52 44 56 C62 60 70 34 88 40 C106 46 114 22 132 26 C150 30 158 52 176 44 C194 36 202 18 220 22 C228 24 234 18 240 14 L240 90 L0 90 Z" fill="url(#signalFill)" />
              <path class="chart__line" d="M0 74 C18 70 26 52 44 56 C62 60 70 34 88 40 C106 46 114 22 132 26 C150 30 158 52 176 44 C194 36 202 18 220 22 C228 24 234 18 240 14" />
              <circle class="chart__dot" r="3.2" cx="0" cy="0" />
            </svg>
            <div class="chart__readout">
              <span class="chart__value"><span data-count="24" data-count-decimals="0">24</span><span class="chart__unit">ms</span></span>
              <span class="label-mono">p95</span>
            </div>
          </div>
        </article>

        <!-- 6 · Scale stat -->
        <article class="tile tile--stat" style="--i:5">
          <header class="tile__head">
            <span class="label-mono">Scale</span>
          </header>
          <div class="stat-block">
            <strong class="stat__value--xl" data-count="164" data-count-suffix="">164</strong>
            <span class="label-mono">tokens · 15 components</span>
          </div>
          <footer class="tile__foot">
            <span class="mono">one source</span>
          </footer>
        </article>

        <!-- 7 · Illustration slot -->
        <article class="tile tile--iso" style="--i:6">
          <header class="tile__head">
            <span class="label-mono">Illustration</span>
            <a class="tile__link mono" href="/illustration">3 scenes ↗</a>
          </header>
          <div class="iso-mini" aria-hidden="true">
            <svg viewBox="0 0 260 190" fill="none">
              <g class="iso-mini__grid">
                <path d="M8 128 L236 128" />
                <path d="M40 148 L236 60" />
                <path d="M24 108 L220 20" />
              </g>
              <g class="iso-mini__float">
                <path d="M96 96 L152 64 L208 96 L208 130 L152 162 L96 130 Z" />
                <path class="iso-mini__hair" d="M96 96 L152 128 L208 96 M152 128 L152 162" />
              </g>
              <g class="iso-mini__float iso-mini__float--b">
                <path d="M40 74 L82 50 L124 74 L124 96 L82 120 L40 96 Z" />
                <path class="iso-mini__hair" d="M40 74 L82 98 L124 74 M82 98 L82 120" />
              </g>
              <g class="iso-mini__float iso-mini__float--c">
                <path d="M160 40 L196 20 L232 40 L232 58 L196 78 L160 58 Z" />
                <path class="iso-mini__hair" d="M160 40 L196 60 L232 40 M196 60 L196 78" />
              </g>
              <path class="iso-mini__trace" d="M124 84 C136 84 132 108 144 108" />
              <path class="iso-mini__trace iso-mini__trace--b" d="M196 58 C196 76 178 78 176 92" />
              <circle class="iso-mini__dot" cx="144" cy="108" r="3" />
              <circle class="iso-mini__dot iso-mini__dot--ink" cx="176" cy="92" r="3" />
            </svg>
          </div>
          <footer class="tile__foot">
            <span class="mono">isometric line · animated</span>
          </footer>
        </article>

        <!-- 8 · Actions -->
        <article class="tile tile--cta" style="--i:7">
          <div class="tile__cta-copy">
            <span class="label-mono">Start here</span>
            <p class="tile__cta-title">Tokens, components,<br />and the whole kit.</p>
          </div>
          <div class="tile__cta-actions">
            <a class="button primary" href="/foundations">Foundations</a>
            <a class="button" href="/components">Try the kit</a>
          </div>
        </article>
      </div>
    </div>

    <div class="hero__rail">
      <span class="mono">Scroll · six chapters</span>
      <span class="hero__rail-line" aria-hidden="true"><i></i></span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 150svh;
    --p: 0;
    background: var(--surface-canvas);
  }

  .hero__sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    display: grid;
    align-content: center;
    overflow: clip;
  }

  /* A grey light-leak behind the top of the grid. Neutral in both modes: it
     reads as a soft lamp in light and a faint bloom in dark. */
  .hero__wash {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(58% 42% at 24% 0%, rgb(0 0 0 / 0.03), transparent 72%),
      radial-gradient(46% 38% at 84% 4%, rgb(0 0 0 / 0.022), transparent 72%);
    opacity: calc(1 - var(--p) * 1.6);
    pointer-events: none;
  }

  [data-theme='dark'] .hero__wash {
    background:
      radial-gradient(60% 46% at 20% 0%, rgb(255 255 255 / 0.055), transparent 72%),
      radial-gradient(52% 42% at 84% 4%, rgb(255 255 255 / 0.035), transparent 72%);
  }

  .hero__stage {
    width: 100%;
    padding-top: calc(var(--nav-height) + var(--space-4));
    transform: translate3d(0, calc(var(--p) * -3vh), 0);
  }

  .bento {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: repeat(6, minmax(0, 1fr));
    gap: 8px;
    height: min(70svh, 640px);
    transform: scale(calc(1 - var(--p) * 0.08));
    transform-origin: 50% 30%;
    opacity: calc(1 - var(--p) * 2.2);
  }

  /* ------------------------------------------------------------- TILES --- */
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-2xl);
    border: 1px solid var(--line-subtle);
    background: var(--surface-raised);
    box-shadow: var(--edge-highlight);
    overflow: hidden;
    isolation: isolate;
    opacity: 0;
    animation: tile-in 760ms var(--ease-emphasis) both;
    animation-delay: calc(var(--i) * 65ms + 100ms);
    transition: border-color var(--dur-med) var(--ease-out);
  }

  .tile:hover {
    border-color: var(--line-default);
  }

  @keyframes tile-in {
    from {
      opacity: 0;
      transform: translate3d(0, 18px, 0) scale(0.985);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .tile__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    position: relative;
    z-index: 2;
  }

  .tile__index {
    color: var(--text-tertiary);
    font-size: var(--text-2xs);
  }

  .tile__foot {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .tile__foot .body-sm {
    color: var(--text-secondary);
    max-width: 34ch;
  }

  /* brand ------------------------------------------------------------------ */
  /* The wordmark tile is the page's inverse: ink on paper in light, paper on
     ink in dark. It is the one block that keeps full contrast in both modes. */
  .tile--brand {
    grid-area: 1 / 1 / 4 / 6;
    background: var(--elem-fill);
    border-color: transparent;
    color: var(--elem-text);
    box-shadow: none;
  }

  .tile--brand .wordmark,
  .tile--brand .tile__tagline {
    color: var(--elem-text);
  }

  .tile--brand .tile__foot .body-sm {
    color: currentColor;
    opacity: 0.72;
  }

  .tile--brand .tile__index {
    color: currentColor;
    opacity: 0.62;
  }

  .tile__brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .wordmark {
    display: flex;
    align-items: flex-end;
    gap: 0.04em;
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    font-variation-settings: "opsz" 32;
    font-size: clamp(3.25rem, 7vw, 6.5rem);
    line-height: 0.82;
    letter-spacing: -0.045em;
    color: currentColor;
    position: relative;
  }

  .wordmark__letters {
    display: flex;
  }

  .wordmark__letter {
    display: inline-block;
    animation: letter-in 820ms var(--ease-emphasis) both;
    animation-delay: calc(var(--n) * 90ms + 360ms);
  }

  @keyframes letter-in {
    from {
      opacity: 0;
      transform: translate3d(0, 0.3em, 0);
      filter: blur(6px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
  }

  .wordmark__dot {
    width: 0.14em;
    height: 0.14em;
    margin-bottom: 0.14em;
    border-radius: 3px;
    background: currentColor;
    animation: dot-pop 600ms var(--ease-spring) both, dot-pulse 3.4s var(--ease-in-out) 1.2s infinite;
    animation-delay: 780ms, 1.2s;
  }

  @keyframes dot-pop {
    from {
      opacity: 0;
      transform: scale(0);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes dot-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgb(128 128 128 / 0.55);
    }
    50% {
      box-shadow: 0 0 0 0.12em rgb(128 128 128 / 0);
    }
  }

  .tile__tagline {
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-snug);
    color: var(--kiln-grey-300);
    opacity: 0;
    animation: kiln-rise-in 760ms var(--ease-out) both;
    animation-delay: 900ms;
  }

  .tile__version {
    color: currentColor;
    opacity: 0.72;
  }

  /* ink swatch ------------------------------------------------------------ */
  .tile--signal {
    grid-area: 1 / 6 / 3 / 9;
    background: var(--kiln-grey-200);
    border-color: transparent;
    color: var(--kiln-ink-1000);
  }

  .tile--signal .label-mono,
  .tile--signal .tile__index,
  .tile--signal .tile__signal-note {
    color: rgb(9 9 9 / 0.62);
  }

  .signal-mark {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding-bottom: 10%;
  }

  .signal-mark svg {
    width: 42%;
    max-width: 84px;
    animation: mark-tilt 10s var(--ease-in-out) infinite;
  }

  @keyframes mark-tilt {
    0%,
    100% {
      transform: translateY(0) rotate(-2deg);
    }
    50% {
      transform: translateY(-5px) rotate(2deg);
    }
  }

  .tile__signal-note {
    font-size: var(--text-2xs);
  }

  /* media ----------------------------------------------------------------- */
  .tile--media {
    grid-area: 1 / 9 / 4 / 13;
    padding: 0;
    background: var(--kiln-ink-1000);
  }

  .tile__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: ken-burns 26s var(--ease-in-out) infinite alternate;
  }

  .tile__img--dim {
    opacity: 0.12;
    filter: grayscale(1);
  }

  @keyframes ken-burns {
    from {
      transform: scale(1.01);
    }
    to {
      transform: scale(1.09) translate3d(-1%, -1.5%, 0);
    }
  }

  .tile__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(9 9 9 / 0.4) 0%, transparent 32%, rgb(9 9 9 / 0.78) 100%);
    z-index: 1;
  }

  .tile__head--over,
  .tile__foot--over {
    z-index: 2;
  }

  .tile--media .tile__head {
    position: absolute;
    inset: var(--space-4) var(--space-4) auto;
  }

  .tile--media .tile__foot {
    position: absolute;
    inset: auto var(--space-5) var(--space-5);
    align-items: flex-end;
  }

  .tile__media-title {
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    font-variation-settings: "opsz" 32;
    font-size: clamp(1.5rem, 2.2vw, 2.25rem);
    line-height: 1.02;
    letter-spacing: var(--tracking-display);
    color: var(--kiln-paper-100);
  }

  .tile__ratio {
    color: rgb(255 255 255 / 0.72);
    font-size: var(--text-2xs);
  }

  /* marquee --------------------------------------------------------------- */
  .tile--marquee {
    grid-area: 3 / 6 / 4 / 9;
    padding: 0;
    justify-content: center;
    background: var(--elem-fill);
    border-color: transparent;
    color: var(--elem-text);
    box-shadow: none;
  }

  .tile--marquee::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      var(--elem-fill) 0%,
      color-mix(in oklab, var(--elem-fill) 60%, transparent) 30%,
      color-mix(in oklab, var(--elem-fill) 60%, transparent) 70%,
      var(--elem-fill) 100%
    );
    z-index: 1;
  }

  .marquee {
    position: relative;
    z-index: 2;
    overflow: hidden;
    mask: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: kiln-marquee 34s linear infinite;
  }

  .marquee__run {
    display: flex;
    align-items: center;
    gap: 0.6em;
    padding-right: 0.6em;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    white-space: nowrap;
    color: currentColor;
    opacity: 0.62;
  }

  .marquee__run em {
    font-style: normal;
  }

  .marquee__run i {
    color: currentColor;
    opacity: 0.8;
    font-style: normal;
  }

  /* chart ----------------------------------------------------------------- */
  .tile--chart {
    grid-area: 4 / 1 / 7 / 4;
    background: var(--surface-raised);
  }

  .chart {
    position: relative;
    z-index: 2;
    display: grid;
    gap: var(--space-2);
  }

  .chart__svg {
    width: 100%;
    height: 80px;
    overflow: visible;
  }

  .chart__line {
    fill: none;
    stroke: var(--text-primary);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-dasharray: 320;
    stroke-dashoffset: 320;
    animation: draw 2s var(--ease-out) 500ms forwards;
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .chart__area {
    opacity: 0;
    animation: kiln-rise-in 1.2s var(--ease-out) 1.3s forwards;
  }

  .chart__dot {
    fill: var(--text-primary);
    offset-path: path('M0 74 C18 70 26 52 44 56 C62 60 70 34 88 40 C106 46 114 22 132 26 C150 30 158 52 176 44 C194 36 202 18 220 22 C228 24 234 18 240 14');
    offset-distance: 0%;
    animation: travel 4.4s var(--ease-in-out) 1.8s infinite;
  }

  @keyframes travel {
    0% {
      offset-distance: 0%;
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
    88% {
      opacity: 1;
    }
    100% {
      offset-distance: 100%;
      opacity: 0;
    }
  }

  .chart__readout {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .chart__value {
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    font-variation-settings: "opsz" 32;
    font-size: var(--text-3xl);
    line-height: 1;
    letter-spacing: var(--tracking-display);
  }

  .chart__unit {
    font-size: 0.5em;
    color: var(--text-tertiary);
    margin-left: 2px;
  }

  /* stat ------------------------------------------------------------------ */
  .tile--stat {
    grid-area: 4 / 4 / 7 / 6;
    background: var(--elem-fill);
    border-color: transparent;
    color: var(--elem-text);
    box-shadow: none;
  }

  .tile--stat .label-mono,
  .tile--stat .mono {
    color: currentColor;
    opacity: 0.66;
  }

  .stat-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    position: relative;
    z-index: 2;
  }

  .stat__value--xl {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: var(--weight-medium);
    font-variation-settings: 'opsz' 32;
    line-height: 1;
    letter-spacing: var(--tracking-display);
    color: currentColor;
  }

  /* iso mini -------------------------------------------------------------- */
  .tile--iso {
    grid-area: 4 / 6 / 7 / 9;
    background: var(--surface-raised);
  }

  .tile__link {
    color: var(--text-accent);
  }

  .tile__link:hover {
    opacity: 0.7;
  }

  .iso-mini {
    position: absolute;
    inset: 34px -4% -6% 2%;
    z-index: 1;
  }

  .iso-mini svg {
    width: 100%;
    height: 100%;
    stroke: var(--illustration-line);
    stroke-width: 1.3;
    stroke-linejoin: round;
    fill: var(--illustration-paper);
  }

  .iso-mini__grid {
    fill: none;
    stroke-opacity: 0.22;
    stroke-dasharray: 1.5 6;
  }

  .iso-mini__hair {
    fill: none;
    stroke-opacity: 0.55;
  }

  .iso-mini__trace {
    fill: none;
    stroke-width: 1.2;
    stroke-dasharray: 3 4;
  }

  .iso-mini__dot {
    fill: var(--illustration-accent);
    stroke: none;
  }

  .iso-mini__dot--ink {
    fill: var(--illustration-line);
  }

  .iso-mini__float {
    animation: kiln-float 7s var(--ease-in-out) infinite;
    animation-delay: 0.4s;
  }

  .iso-mini__float--b {
    animation-duration: 8.5s;
    animation-delay: 1.1s;
  }

  .iso-mini__float--c {
    animation-duration: 6.2s;
    animation-delay: 0.2s;
  }

  .iso-mini__trace {
    animation: trace-march 1.4s linear infinite;
  }

  .iso-mini__trace--b {
    animation-duration: 2.1s;
    animation-direction: reverse;
  }

  @keyframes trace-march {
    to {
      stroke-dashoffset: -14;
    }
  }

  /* cta ------------------------------------------------------------------- */
  .tile--cta {
    grid-area: 4 / 9 / 7 / 13;
    justify-content: space-between;
    background: var(--surface-subtle);
    border-color: var(--line-default);
  }

  .tile__cta-copy {
    display: grid;
    gap: var(--space-2);
    margin-top: auto;
  }

  .tile__cta-title {
    font-family: var(--font-display);
