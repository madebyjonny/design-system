      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: none;
      height: auto;
      transform: none;
      opacity: 1;
    }

    .tile {
      grid-area: auto !important;
      min-height: 140px;
    }

    .tile--brand,
    .tile--media,
    .tile--cta {
      grid-column: span 2 !important;
      min-height: 210px;
    }

    .tile--media {
      min-height: 280px;
    }

    .hero__rail {
      position: static;
      margin-top: var(--space-5);
    }
  }

  @media (max-width: 520px) {
    .bento {
      grid-template-columns: 1fr;
    }

    .tile,
    .tile--brand,
    .tile--media,
    .tile--cta {
      grid-column: span 1 !important;
    }
  }
</style>

<script>
  import { onScroll } from '@/scripts/reveal';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const bento = document.querySelector<HTMLElement>('[data-hero-bento]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (hero && bento) {
    const update = ({ y }: { y: number; vh: number }) => {
      const scrollable = hero.offsetHeight - window.innerHeight;
      if (scrollable <= 0) {
        hero.style.setProperty('--p', '0');
        return;
      }
      const progress = Math.min(1, Math.max(0, -hero.getBoundingClientRect().top / scrollable));
      hero.style.setProperty('--p', progress.toFixed(4));
    };

    if (!reduced.matches) onScroll(update);
  }
</script>
